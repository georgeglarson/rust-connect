#!/bin/sh
set -e

# rust-connect runs as a USER service, not a system service: it needs the
# session DBus (desktop notifications), $HOME (identity + paired.json), and
# ~/Downloads (received files). See packaging/rust-connect.service.
#
# The unit ships to /usr/lib/systemd/user/ but is NOT enabled globally.
# `systemctl --global enable` reaches every user manager on the host,
# including display-manager greeter users (Fedora's gdm-greeter, tmpfs
# home): each boot they ran their own daemon with a fresh identity, dialed
# the paired phones, and held port 1716 so the real user's daemon
# crash-looped until login. Enabling is a per-user act:
#     systemctl --user enable --now rust-connect.service
#
# Earlier builds of this package DID enable it globally; undo that so an
# upgrade repairs the greeter double-daemon instead of preserving it.
# Per-user enables (~/.config/systemd/user/default.target.wants) are
# untouched.
systemctl daemon-reload || true
systemctl --global disable rust-connect.service 2>/dev/null || true

echo "rust-connect: enable it for your own session with:"
echo "    systemctl --user enable --now rust-connect.service"
